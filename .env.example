# SellerPlus by ReyoStudio — environment template
# Copy to .env.local for development. Never commit a populated env file.

# Browser-safe Supabase project settings (required for the web app).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy Supabase name accepted for compatibility; prefer PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential (required for authenticated API routes/workers).
# Use the modern secret key when available; SERVICE_ROLE_KEY is retained for older projects.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Amazon SP-API application defaults (server-only; workspace credentials are preferred).
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_APPLICATION_ID=
AMAZON_SP_API_REGION=IN
AMAZON_SP_API_SANDBOX=false
AMAZON_SYNC_BATCH_SIZE=100

# Amazon Ads application defaults (server-only; never expose the secret).
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
# Client ID only: retained for legacy connection displays, never put a secret here.
NEXT_PUBLIC_AMAZON_SP_CLIENT_ID=
NEXT_PUBLIC_AMAZON_ADS_CLIENT_ID=

# Credential encryption keyring. JSON object with an active version, for example:
# {"active":"v1","keys":{"v1":"<base64-32-byte-key>"}}
SELLERPLUS_ENCRYPTION_KEYS=

# Scheduled worker authentication (required in production).
CRON_SECRET=
SELLERPLUS_WORKER_ID=

# AI providers (optional; credentials entered per workspace are encrypted in Supabase).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
AI_DEFAULT_MODEL=gemini-1.5-flash
GEMINI_DEFAULT_MODEL=
NVIDIA_DEFAULT_MODEL=
OPENROUTER_DEFAULT_MODEL=
AI_TIMEOUT=15000
AI_MAX_RETRIES=3
AI_CACHE_TTL=86400
AI_NEGATIVE_CACHE_TTL=60
AI_CIRCUIT_COOLDOWN_MS=300000
AI_CIRCUIT_FAILURE_THRESHOLD=3
GEMINI_INPUT_COST_PER_MILLION=
GEMINI_OUTPUT_COST_PER_MILLION=
NVIDIA_INPUT_COST_PER_MILLION=
NVIDIA_OUTPUT_COST_PER_MILLION=
OPENROUTER_INPUT_COST_PER_MILLION=
OPENROUTER_OUTPUT_COST_PER_MILLION=

# Notifications (optional; configured values are encrypted when stored per workspace).
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=

# Product metadata and optional legal/support links.
SELLERPLUS_BUILD_ID=
SELLERPLUS_UPDATE_CHANNEL=stable
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_SUPPORT_URL=

# Development only. Production authentication fails closed regardless of this flag.
SELLERPLUS_ALLOW_INSECURE_DEV_AUTH=false

# Optional legacy finance/worker settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WORKER_INVENTORY_ALERT_INTERVAL=0 0 * * *
WORKER_LOW_STOCK_THRESHOLD=10
WORKER_PROFIT_LEAK_SCAN_PERIOD=0 * * * *
LOG_LEVEL=info
